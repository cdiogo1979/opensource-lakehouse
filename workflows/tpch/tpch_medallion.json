{
  "apiVersion": "lakehouse.local/workflow/v1",
  "name": "tpch_medallion",
  "description": "TPC-H medallion load: per entity, append a DuckDB-generated batch to bronze (tpch_<entity>_db_brz), then merge the new bronze snapshots into silver (tpch_<entity>).",
  "schedule": null,
  "tags": ["tpch", "bronze", "silver"],
  "tasks": [
    {"name": "tpch_region_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "region"]},
    {"name": "tpch_nation_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "nation"]},
    {"name": "tpch_supplier_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "supplier"]},
    {"name": "tpch_customer_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "customer"]},
    {"name": "tpch_part_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "part"]},
    {"name": "tpch_partsupp_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "partsupp"]},
    {"name": "tpch_orders_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "orders"]},
    {"name": "tpch_lineitem_db_brz_load", "entrypoint": "bronze/bronze_ingestion.py", "args": ["--entity", "lineitem"]},
    {"name": "tpch_region_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_region_db_brz_load"], "args": ["--entity", "region"]},
    {"name": "tpch_nation_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_nation_db_brz_load"], "args": ["--entity", "nation"]},
    {"name": "tpch_supplier_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_supplier_db_brz_load"], "args": ["--entity", "supplier"]},
    {"name": "tpch_customer_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_customer_db_brz_load"], "args": ["--entity", "customer"]},
    {"name": "tpch_part_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_part_db_brz_load"], "args": ["--entity", "part"]},
    {"name": "tpch_partsupp_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_partsupp_db_brz_load"], "args": ["--entity", "partsupp"]},
    {"name": "tpch_orders_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_orders_db_brz_load"], "args": ["--entity", "orders"]},
    {"name": "tpch_lineitem_load", "entrypoint": "silver/silver_processing.py", "runs_after": ["tpch_lineitem_db_brz_load"], "args": ["--entity", "lineitem"]}
  ]
}
